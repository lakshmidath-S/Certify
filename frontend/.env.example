# Origin of the backend API — origin ONLY: no /api suffix, no trailing slash.
# The value is inlined at BUILD time, so changing it requires a rebuild.
#
#   Local development : leave unset (the Vite dev proxy forwards /api to BACKEND_URL)
#   Production        : https://your-backend-url.onrender.com
#   Same-origin proxy : /
#
# `npm run build` fails if this is unset or points at localhost — that misbuild
# used to deploy fine for whoever built it and break for every other visitor.
VITE_API_URL=

# Where `npm run dev` proxies /api to. Optional, defaults to http://localhost:3000.
BACKEND_URL=http://localhost:3000

# CertificateRegistry address MetaMask anchors certificate hashes to.
# Optional — defaults to the currently deployed registry. It MUST match the
# backend's CONTRACT_CERT_REGISTRY or every certificate verifies as NOT_ON_CHAIN.
VITE_CERT_REGISTRY_ADDRESS=
