# ===== Database =====
# Managed Postgres requires TLS. TLS is now decided from this URL (or
# DATABASE_SSL below), not from NODE_ENV, so `?sslmode=require` is honoured.
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Optional TLS override: true | false. Leave unset to derive it from
# DATABASE_URL — TLS on for any remote host, off for localhost.
# DATABASE_SSL=

# Optional pool tuning.
# DB_POOL_MAX=10
# DB_CONNECTION_TIMEOUT_MS=15000
# DB_IDLE_TIMEOUT_MS=30000
# DB_CONNECT_ATTEMPTS=5

# ===== Server =====
# Leave PORT unset on Render/Railway/Fly — the platform injects it.
PORT=3000
NODE_ENV=production
# HOST=0.0.0.0

# Exact origin of the deployed frontend, e.g. https://certify-frontend.vercel.app
# (scheme + host, no trailing slash). Unset means CORS allows every origin.
FRONTEND_URL=
# Extra allowed origins, comma-separated — useful for preview deployments.
# CORS_ORIGINS=

# ===== JWT =====
JWT_SECRET=your_jwt_secret_min_32_characters_long
JWT_EXPIRES_IN=1h

# ===== Blockchain =====
RPC_URL=https://sepolia.base.org
CONTRACT_WALLET_REGISTRY=0xYourWalletRegistryAddress
CONTRACT_CERT_REGISTRY=0xYourCertRegistryAddress
DEPLOYER_PRIVATE_KEY=your_deployer_private_key_without_0x_prefix

# ===== Admin =====
ADMIN_WALLET_ADDRESS=0xYourAdminWalletAddress

# ===== PDF Digital Signing =====
P12_BASE64=your_base64_encoded_p12_certificate_string
P12_PASSWORD=your_cert_password

# ===== Storage =====
# Where issued PDFs are written. Absolute, or relative to backend/.
# Defaults to backend/storage/certificates. Point it at a mounted persistent
# disk to keep signed PDFs across restarts — otherwise downloads regenerate
# them unsigned from the canonical JSON.
# CERT_STORAGE_DIR=/var/data/certificates
